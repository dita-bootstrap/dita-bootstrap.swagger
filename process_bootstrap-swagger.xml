<project
  name="org.dita-bootstrap.swagger"
  default="bootstrap-swagger.css.copy"
  xmlns:if="ant:if"
  xmlns:unless="ant:unless"
>

	<target name="bootstrap-swagger.init" unless="swagger.use.theme">
		<property
      name="swagger.css.theme"
      value="${dita.plugin.org.dita-bootstrap.swagger.dir}/css/bootstrap-theme.css"
    />
	</target>

	<target name="bootstrap-swagger.css.copy">
		<loadfile
      property="bootstrap-swagger.css"
      srcFile="${dita.plugin.org.dita-bootstrap.swagger.dir}/css/bootstrap-swagger.css"
    />
		<echo
      append="true"
      message="${line.separator}${bootstrap-swagger.css}"
      file="${extend.css.file}"
    />
	</target>
</project>
